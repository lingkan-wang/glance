{
  "manifest_version": 3,
  "name": "Glance 一瞥",
  "version": "1.0.0",
  "description": "选中即译。网页与 PDF 论文的实时中文对照，克制的苹果式浮层。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "declarativeNetRequest", "contextMenus", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/lens/lens.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "action": {
    "default_title": "Glance",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/viewer/*", "src/lens/*", "vendor/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
